{
  "name": "bilim-hezinisi",
  "version": "3.1.0",
  "description": "بىلىم خەزىنىسى - Uyghur Digital Library",
  "main": "main.js",
  "scripts": {
    "setup": "node setup-pdfjs.js",
    "postinstall": "electron-rebuild -f -w better-sqlite3 && node scripts/copy-dompurify.js && node scripts/copy-vendor.js",
    "fetch-quran": "node scripts/fetch-quran-data.js",
    "fetch-ocr-models": "node scripts/fetch-ocr-models.js",
    "build-spelldict": "node scripts/build-spelldict.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "dist-win": "electron-builder --win --x64",
    "dist-win-store": "electron-builder --win appx --x64",
    "dist-mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist-mac-release": "electron-builder --mac -c.mac.notarize=true",
    "dist-mas": "electron-builder --mac mas",
    "dist-linux": "electron-builder --linux",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.bilim.hezinisi",
    "productName": "Bilim Hezinisi",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "compression": "maximum",
    "removePackageScripts": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "files": [
        "!node_modules/better-sqlite3/prebuilds/darwin-*",
        "!node_modules/better-sqlite3/prebuilds/linux*"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "بىلىم خەزىنىسى",
      "allowElevation": false,
      "perMachine": false,
      "runAfterFinish": true,
      "installerIcon": "assets/installer-icon.ico",
      "uninstallerIcon": "assets/installer-icon.ico",
      "installerHeaderIcon": "assets/installer-icon.ico"
    },
    "portable": {
      "artifactName": "BilimHezinisi-Portable-${version}.exe"
    },
    "appx": {
      "identityName": "REPLACE-WITH-PARTNER-CENTER-IDENTITY-NAME",
      "publisher": "CN=REPLACE-WITH-PARTNER-CENTER-PUBLISHER-ID",
      "publisherDisplayName": "REPLACE-WITH-PARTNER-CENTER-DISPLAY-NAME",
      "applicationId": "BilimHezinisi",
      "displayName": "بىلىم خەزىنىسى",
      "backgroundColor": "#FFFBF5",
      "languages": [
        "ug",
        "en-US"
      ],
      "artifactName": "BilimHezinisi-${version}-store.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.reference",
      "files": [
        "!node_modules/better-sqlite3/prebuilds/win32-*",
        "!node_modules/better-sqlite3/prebuilds/linux*"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHumanReadableCopyright": "Jamiy Kutupxana"
      },
      "artifactName": "BilimHezinisi-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "BilimHezinisi-${version}-mac-${arch}.${ext}"
    },
    "mas": {
      "category": "public.app-category.reference",
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "hardenedRuntime": false,
      "provisioningProfile": "build/embedded.provisionprofile",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "files": [
      "main.js",
      "ai.js",
      "preload.js",
      "database.js",
      "ocr-postprocess.js",
      "src/**/*",
      "assets/ukijekran.ttf",
      "assets/trad-arabic.ttf",
      "assets/trad-arabic-bold.ttf",
      "assets/Bahij_Nazanin-Regular.ttf",
      "assets/icon.*",
      "assets/installer-icon.ico",
      "assets/pdfjs/**/*",
      "assets/fonts/**/*",
      "assets/seed/**/*",
      "src/quran.js",
      "src/quran.css",
      "src/notes.js",
      "src/notes.css",
      "src/ngram.js",
      "src/spellcheck.js",
      "assets/spellcheck/uyghur_words.txt",
      "assets/spellcheck/uyghur_corrections.json",
      "assets/vendor/**/*",
      "assets/ocr/**/*",
      "scripts/**/*",
      "!scripts/build-spelldict.js",
      "!assets/spellcheck/raw/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*",
      "assets/ocr/**/*"
    ],
    "nodeGypRebuild": false
  },
  "keywords": [
    "uyghur",
    "library",
    "kutupxana",
    "arabic",
    "islamic"
  ],
  "author": "Jamiy Kutupxana",
  "license": "MIT",
  "overrides": {
    "node-abi": "^4.33.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "pdfjs-dist": "3.11.174"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^13.0.2",
    "docx": "^8.5.0",
    "dompurify": "^3.4.1",
    "electron-window-state": "^5.0.3",
    "mammoth": "^1.6.0",
    "node-html-parser": "^6.1.13",
    "tesseract.js": "^5.0.0",
    "turndown": "^7.2.4",
    "word-extractor": "^1.0.4"
  }
}
