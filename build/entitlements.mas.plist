<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Mac App Store build. The sandbox is mandatory here. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>

  <!-- Gemini AI (opt-in, main process only). -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!--
    Book import/export and OCR image picking go through dialog.showOpenDialog /
    showSaveDialog, which grant access via Powerbox under the sandbox.
  -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>

  <!-- The book reader offers Print / export to PDF. -->
  <key>com.apple.security.print</key>
  <true/>
</dict>
</plist>
